{
    "python.formatting.blackArgs": [
        // "--line-length=100",
        // "--target-version=py37"
    ],
    // Pylint
    "python.linting.pylintArgs": [
        "--attr-rgx=[a-z_][a-z0-9_]{1,30}$|[xyzUVW]$",
        "--variable-rgx=[a-z_A][a-z0-9_]{0,30}|[UVWXYZ]$",
        "--disable=missing-docstring",
        "--disable=too-few-public-methods",
        "--disable=duplicate-code",
        "--notes='FIXME,XXX,###'",
        "--max-args=8",
        "--max-attributes=16",
        "--max-public-methods=32",
        "--max-locals=25",
        "--max-attributes=16",
        "--generated-members=torch.*"
    ],
    // Pytest
    "python.testing.pytestArgs": [
        "tests",
        "--capture=no",
        "--durations=10",
        "--numprocesses=auto"
    ],
    "python.testing.pytestEnabled": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "python.formatting.provider": "none",
    "nvidia-smi-plus.refresh.autoRefresh": true,
    "workbench.colorCustomizations": {
        "commandCenter.border": "#15202b99",
        "titleBar.activeBackground": "#74b8e0",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#74b8e099",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.remoteColor": "#74b8e0"
}